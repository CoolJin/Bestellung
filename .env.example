# Kopiere diese Datei zu `.env` und trage deine Werte ein.
#
# ACHTUNG: Beide Werte landen im gebauten JavaScript und sind auf der
# veröffentlichten Seite für jeden lesbar. Das ist beim Publishable Key so
# vorgesehen. Der eigentliche Schutz kommt von den RLS-Policies in der
# Datenbank (siehe supabase/README.md), NICHT davon, dass der Key geheim ist.
#
# Der Service-Role-Key gehört NIEMALS hier hinein.

VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Optional: Make.com-Szenario zur Prüfung der Discord-ID
# Ohne diesen Wert wird die eingegebene ID ungeprüft übernommen.
VITE_DISCORD_VERIFY_WEBHOOK_URL=
